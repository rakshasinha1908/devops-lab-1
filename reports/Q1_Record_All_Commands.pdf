q q 1 0 0 1 42 726 cm .058824 .090196 .164706 rg BT 14 TL/F2 10 Tf 1 0 0 1 0 4 Tm (Phase 3: Repository Lifecycle, Feature Branching & Merging)Tj T* ET Q q 1 0 0 1 36 569.5 cm .058824 .090196 .164706 rg 0 152.5 540 -152.5 re f* q 1 0 0 1 7 5 cm .886275 .909804 .941176 rg BT 9.5 TL/F3 7.5 Tf 1 0 0 1 0 135 Tm (# Initialize repository and create initial commit)Tj T* (git init -b main)Tj T* (git add .)Tj T* (git commit -m "feat: Initial commit of DevOps Lab 1 application and CI/CD pipeline")Tj T* T* (# Branch out for feature enhancement)Tj T* (git checkout -b feature/enhance-ui-metrics)Tj T* (git add app.py test_app.py)Tj T* (git commit -m "feat\(metrics\): add /metrics monitoring endpoint and test coverage")Tj T* T* (# Merge back into main with explicit non-fast-forward merge commit)Tj T* (git checkout main)Tj T* (git merge --no-ff feature/enhance-ui-metrics -m "merge: Merge branch 'feature/enhance-ui-metrics' into main")Tj T* (git remote add origin https://github.com/rohitraj1106/Devops-Lab-1.git)Tj T* (git push -u origin main)Tj T* ET Q q .2 .254902 .333333 RG 1 J 1 j .5 w 0 152.5 m 540 152.5 l S 0 0 m 540 0 l S 0 0 m 0 152.5 l S 540 0 m 540 152.5 l S Q Q q 1 0 0 1 42 535.5 cm .011765 .411765 .631373 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm (3. Git Commit History Log & Graph Output)Tj T* ET Q q 1 0 0 1 42 518.5 cm .117647 .160784 .231373 rg BT 12 TL/F1 8.5 Tf 1 0 0 1 0 3.5 Tm (Exact output generated from git log --graph --oneline --all --decorate)Tj (:)Tj T* ET Q q 1 0 0 1 36 456 cm .058824 .090196 .164706 rg 0 57.5 540 -57.5 re f* q 1 0 0 1 7 5 cm .886275 .909804 .941176 rg BT 9.5 TL/F3 7.5 Tf 1 0 0 1 0 40 Tm (*   93a862a \(HEAD -> main\) merge: Merge branch 'feature/enhance-ui-metrics' into main)Tj T* (|\\  )Tj T* (| * 1a63744 \(feature/enhance-ui-metrics\) feat\(metrics\): add /metrics monitoring endpoint and test coverage)Tj T* (|/  )Tj T* (* fb5fb47 feat: Initial commit of DevOps Lab 1 application and CI/CD pipeline)Tj T* ET Q q .2 .254902 .333333 RG 1 J 1 j .5 w 0 57.5 m 540 57.5 l S 0 0 m 540 0 l S 0 0 m 0 57.5 l S 540 0 m 540 57.5 l S Q Q q 1 0 0 1 42 422 cm .011765 .411765 .631373 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm (4. Verbatim Declarative Pipeline Configuration)Tj T* ET Q q 1 0 0 1 36 150.5 cm .058824 .090196 .164706 rg 0 266.5 540 -266.5 re f* q 1 0 0 1 7 5 cm .886275 .909804 .941176 rg BT 9.5 TL/F3 7.5 Tf 1 0 0 1 0 249 Tm (pipeline {)Tj T* (    agent any)Tj T* (    options { timeout\(time: 20, unit: 'MINUTES'\); timestamps\(\); ansiColor\('xterm'\) })Tj T* (    triggers { githubPush\(\); pollSCM\('H/5 * * * *'\) })Tj T* (    environment { APP_NAME = 'devops-sample-app'; APP_VERSION = "1.0.${BUILD_NUMBER}" })Tj T* (    stages {)Tj T* (        stage\('Checkout Source'\) { steps { checkout scm } })Tj T* (        stage\('Build & Dependencies'\) {)Tj T* (            steps { sh 'python3 -m venv venv && . venv/bin/activate && pip install -r requirements.txt' })Tj T* (        })Tj T* (        stage\('Run Tests'\) {)Tj T* (            steps { sh '. venv/bin/activate && python3 -m pytest test_app.py --junitxml=test-results.xml' })Tj T* (            post { always { junit allowEmptyResults: true, testResults: 'test-results.xml' } })Tj T* (        })Tj T* (        stage\('Package Artifacts'\) {)Tj T* (            steps { sh 'mkdir -p dist && tar -czf dist/${APP_NAME}-v${BUILD_NUMBER}.tar.gz app.py Dockerfile' })Tj T* (            post { success { archiveArtifacts artifacts: 'dist/*.tar.gz' } })Tj T* (        })Tj T* (        stage\('Deploy Application'\) { steps { sh 'chmod +x deploy.sh && ./deploy.sh' } })Tj T* (        stage\('Health Verification'\) { steps { sh 'curl -s -f http://localhost:5000/health | grep UP' } })Tj T* (    })Tj T* (    post {)Tj T* (        always { cleanWs deleteDirs: true })Tj T* (        success { echo "Build #${BUILD_NUMBER} passed and deployed successfully!" })Tj T* (        failure { echo "Build #${BUILD_NUMBER} failed! Check console logs." })Tj T* (    })Tj T* (})Tj T* ET Q q .2 .254902 .333333 RG 1 J 1 j .5 w 0 266.5 m 540 266.5 l S 0 0 m 540 0 l S 0 0 m 0 266.5 l S 540 0 m 540 266.5 l S Q Q q .007843 .517647 .780392 rg BT 9.6 TL/F2 8 Tf 1 0 0 1 36 762 Tm (LAB 1: DEVOPS FOUNDATIONS & CONTINUOUS INTEGRATION)Tj T* ET .392157 .454902 .545098 rg BT/F1 8 Tf 1 0 0 1 471.08 762 Tm (Academic Submission Report)Tj T* ET .796078 .835294 .882353 RG .5 w 36 756 m 576 756 l S 36 36 m 576 36 l S BT/F1 8 Tf 1 0 0 1 36 24 Tm T* ET BT 1 0 0 1 535.08 24 Tm (Page 2 of 3)Tj T* ET Q Q
